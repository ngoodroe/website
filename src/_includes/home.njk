{% extends "layout.njk" %}

{% block content %}
<h1>{{ site.author.name }}</h1>

<h3>Writer & illustrator from Atlanta, Georgia.</h3>

{% if content | trim %}
{{ content | safe }}
<hr>
{% endif %}

{%- for categoryName, items in links %}
{%- if items | length and items[0].title %}
<h2>{{ categoryName }}</h2>
<ul>
  {%- for item in items %}
  {%- if item.title %}
  <li>
    {%- if item.url %}<a href="{{ item.url }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
    {%- if item.pub %} &mdash; {{ item.pub }}{% endif %}
    {%- if item.description %}<br>{{ item.description }}{% endif %}
  </li>
  {%- endif %}
  {%- endfor %}
</ul>
{%- endif %}
{%- endfor %}

<hr>

<h2>Recent Posts</h2>
<ul>
{%- for post in collections.blog | head(5) %}
  <li><a href="{{ post.url }}">{{ post.data.title }}</a>
  {%- if post.data.description %}
  — {{ post.data.description }}
  {%- endif %}
  </li>
{%- else %}
  <li>No posts yet.</li>
{%- endfor %}
</ul>
{% endblock %}
